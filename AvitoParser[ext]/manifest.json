{
  "manifest_version": 3,
  "name": "Avito Custom Multi-Page Parser",
  "version": "1.0",
  "description": "Парсит названия, цены, ссылки и описания с Авито в один файл.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.avito.ru/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.avito.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}